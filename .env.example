# ATS Resume Analyzer Bot Configuration

# Telegram Bot Token
# Get from: https://t.me/BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Groq API Key
# Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Copy this file to .env before running the bot
# Example: copy .env.example .env

# Groq Model (Free options)
# Available: mixtral-8x7b-32768, llama-3-70b-8192, llama-2-70b-chat
GROQ_MODEL=mixtral-8x7b-32768

# Database path
DATABASE_PATH=ats_bot.db

# Temporary files directory
TEMP_DIR=temp_files

# Max file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Groq API timeout in seconds
GROQ_TIMEOUT=60
